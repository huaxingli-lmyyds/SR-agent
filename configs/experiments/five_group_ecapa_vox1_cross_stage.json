{
  "model_family": "ecapa_tdnn",
  "train_config": "configs/train_ecapa_tdnn_vox1_full.yaml",
  "validation_config": "configs/verification_ecapa_vox1_full.yaml",
  "runner": "speechbrain",
  "implementation": "speechbrain",
  "model_name": "GLM-4.7",
  "temperature": 0.0,
  "seeds": [
    11,
    22,
    33
  ],
  "data_prep_seed": 0,
  "full_epochs": 6,
  "full_trials": 9,
  "sh_initial_trials": 9,
  "promotion_limits": [
    3,
    1
  ],
  "budgets": [
    {
      "stage": "screen",
      "epochs": 1,
      "data_fraction": 1.0,
      "max_duration_seconds": 7200
    },
    {
      "stage": "promote",
      "epochs": 3,
      "data_fraction": 1.0,
      "max_duration_seconds": 14400
    },
    {
      "stage": "full",
      "epochs": 6,
      "data_fraction": 1.0,
      "max_duration_seconds": 28800
    }
  ],
  "candidate_batch_size": 3,
  "n_startup_trials": 3,
  "max_retries": 0,
  "device": "cuda:0",
  "batch_size_semantics": "per_device",
  "precision": "bf16",
  "eval_precision": "fp32",
  "search_space": {
    "parameters": [
      {
        "name": "lr",
        "parameter_type": "float",
        "low": 0.0005,
        "high": 0.003,
        "scale": "log"
      },
      {
        "name": "margin",
        "parameter_type": "float",
        "low": 0.15,
        "high": 0.3
      },
      {
        "name": "weight_decay",
        "parameter_type": "float",
        "low": 5e-07,
        "high": 2e-05,
        "scale": "log"
      }
    ],
    "constraints": []
  },
  "max_gpu_hours": 96,
  "max_wall_seconds": 432000,
  "parallel_single_gpu": true,
  "hypothesis_probes": false,
  "cross_stage_probes": true
}
